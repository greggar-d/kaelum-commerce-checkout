# KAELUM Commerce Checkout configuration.
# Copy to .env and fill in. The two live KAELUM endpoints this backend calls are
# kaelumDiscover (public, read-only) and createUniversalPaymentSession (Bearer token).

# KAELUM functions origin. The live WebMCP layer calls functions here.
KAELUM_FUNCTIONS_BASE=https://kaelum.app/functions

# A KAELUM MerchantToken issued for the store this deployment sells for.
# Required to create a payment session (the checkout hand-off). Discovery works without it.
KAELUM_MERCHANT_TOKEN=

# Optional discovery scope hint: the merchant's Wix site_key or Integration site_token.
KAELUM_SITE_KEY=

# Where KAELUM returns the customer after the gateway.
KAELUM_SUCCESS_URL=https://kaelum.app/checkout/success
KAELUM_CANCEL_URL=https://kaelum.app/checkout/cancel

# Needed only to run a live model turn via app/main.py (not for discovery or the smoke script).
ANTHROPIC_API_KEY=

# Path to a local clone of anthropics/commerce-agents, for its shipped skills.
COMMERCE_AGENTS_SKILLS_DIR=../commerce-agents/shopping-agent/skills
